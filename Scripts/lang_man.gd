extends Node


@onready var cond_list_: Button = $"../Ui Handler/cond_list_"
@onready var monst_list: Button = $"../Ui Handler/monst_list"
@onready var ativar: Button = $"../ativar"
@onready var desativar: Button = $"../desativar"
@onready var arma_list: Button = $"../Ui Handler/arma_list"
@onready var ativar_ar: Button = $"../ativar_ar"
@onready var desativar_ar: Button = $"../desativar_ar"
@onready var menu: Button = $"../Ui Handler/menu"
@onready var settings: Button = $"../Ui Handler/settings"
@onready var filter: LineEdit = $"../filter"
@onready var salvar: Button = $"../condicoes/leitura/salvar"
@onready var carregar: Button = $"../condicoes/leitura/carregar"
@onready var inserir: LineEdit = $"../condicoes/Inserir"

func _ready() -> void:
	if GameManager.language == "BR":
		cond_list_.text = "Condições"
		monst_list.text = "Monstros"
		ativar.text = "Ativar Todos"
		desativar.text = "Desativar Todos"
		arma_list.text = "Armas"
		ativar_ar.text = "Ativar Todos"
		desativar_ar.text = "Desativar Todos"
		menu.text = "Voltar para o menu"
		filter.placeholder_text = "Filtro"
		salvar.text = "salvar"
		carregar.text = "carrega"
		inserir.placeholder_text = "Inserir Condição"
	elif GameManager.language == "US":
		cond_list_.text = "Conditions"
		monst_list.text = "Monsters"
		ativar.text = "Activate All"
		desativar.text = "Deactivate All"
		arma_list.text = "Weapons"
		ativar_ar.text = "Activate All"
		desativar_ar.text = "Deactivate All"
		menu.text = "Back to Menu"
		filter.placeholder_text = "Filter"
		salvar.text = "save"
		carregar.text = "load"
		inserir.placeholder_text = "Insert condition"
